# =============================================================================
# Deployment Webhook Configuration
# =============================================================================

# --- Compose File Selection ---
# Uncomment ONE of the following lines based on your reverse proxy:
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# --- Webhook ---
# GitHub Webhook Secret (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=your_webhook_secret_here

# Domain for the webhook endpoint
WEBHOOK_DOMAIN=webhook.yourdomain.com

# --- Reverse Proxy Networks ---
# Traefik
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERT_RESOLVER=letsencrypt

# Caddy (uncomment if using Caddy)
# CADDY_NETWORK=caddy

# --- Target Application ---
# Path to your application repository (must be identical on host and in container)
TARGET_REPO_PATH=/path/to/your/application
TARGET_SERVICE_NAME=your_service_name

# --- Build ---
# Docker socket GID (detect with: stat -c '%g' /var/run/docker.sock)
# On macOS use: stat -f '%g' /var/run/docker.sock
# DOCKER_GID=999
